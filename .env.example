# ───────────────────────────────────────────────────────────────
# LOOP — environment variables
# Copy to `.env` and fill in. `.env` is git-ignored; never commit it.
# ───────────────────────────────────────────────────────────────

# Notion ─────────────────────────────────────────────────────────
NOTION_TOKEN=
NOTION_ARTICLE_LIBRARY_DB=2089131e-0973-4b7d-8f10-3c39cef7a63f
NOTION_CONTENT_DRAFTS_DB=216ebf08-3c4a-44fc-9467-a30bc12030a6
NOTION_PERFORMANCE_LOG_DB=21e2c21c-b4ca-4d2f-823b-426f530e6fca
# Agent Rules DB — single source of truth for learned rules.
# Loop 2 writes it; Loop 1 reads the Active operational rows.
NOTION_AGENT_RULES_DB=4acdaa17-0e02-4aa6-988a-06927c905b96

# X / Twitter API v2 ─────────────────────────────────────────────
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=
# Include the CTA link on X posts? Default true — the CTA is just a bare link
# (no sell copy). Set false to post X link-free (max reach, no link
# suppression) while growing followers; Threads keeps the link regardless.
X_INCLUDE_CTA=true
# Every tweet in a chain costs one monthly write credit — cap X chains at the
# root tweet (full chain still posts on Threads). Raise after a tier upgrade.
X_MAX_THREAD_POSTS=1
# Randomized per-post X link A/B (on by default): each X post flips a fair coin
# between carrying its link and going link-free, tagged on the Performance row
# so Loop 2 measures the reach cost cleanly. Set false to stop the experiment.
X_LINK_AB=true
# Free-tier monthly write allowance; LEARN warns at 80% usage.
X_MONTHLY_WRITE_BUDGET=500
# Per-issue CTA override used only on X (JSON {"issue": "url"}). X suppresses
# Substack links hardest; build-in-public pieces link their GitHub repo on X
# while Threads keeps the article CTA. Default maps 201 → tree-quant-ledger.
X_CTA_BY_ISSUE=

# Threads (Meta) — optional; enables posting to Threads ──────────
# Create an app at developers.facebook.com with the "Threads API" use case,
# add yourself as a Threads tester, then generate a long-lived user token
# with threads_basic + threads_content_publish + threads_manage_insights
# (the last scope lets Loop 2 read post metrics). Token lasts ~60 days.
THREADS_ACCESS_TOKEN=
# Optional — resolved automatically from /me when blank.
THREADS_USER_ID=

# Instagram (Meta) — optional; posts Quote Cards as image cards ───
# Switch the IG account to Professional, add the "Instagram" product to
# the same Meta app, then generate a token with instagram_business_basic
# + instagram_business_content_publish. The instagram.yml workflow renders
# the card, commits it so raw.githubusercontent serves the public image_url,
# then publishes daily (12:30 HKT).
IG_ACCESS_TOKEN=
# Optional — resolved automatically from /me when blank.
IG_USER_ID=
# Public base URL for the committed cards/ PNGs (IG needs a public image_url).
# CI sets this from the repo + branch; leave blank locally.
IG_CARD_URL_BASE=
# Fallback CTA line, used only when a card has no resolvable article link;
# normally the caption carries the card's real per-article Substack link.
IG_CTA_LINE=完整框架在 Substack，連結見 bio 🔗
IG_HASHTAGS=#投資 #價值投資 #財經 #stockmarket
# Optional — override the CJK font used to render cards.
IG_FONT_PATH=

# Claude API (Loop 3) ────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# Config ─────────────────────────────────────────────────────────
MAX_POSTS_PER_RUN=1
DAILY_HARD_LIMIT=5
POST_SLOTS_HKT=07:30,10:00,12:30,18:30,21:30
TZ_NAME=Asia/Hong_Kong
# Seconds to show the console preview before posting (Ctrl+C to abort)
PREVIEW_COUNTDOWN_SECONDS=5
DRY_RUN=false
